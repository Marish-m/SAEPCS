# ==============================================================================
# SAEPCS BACKEND CONFIGURATION (.env.example)
# Student Academic Engagement & Parent Communication System
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# ------------------------------------------------------------------------------
# Real MongoDB Atlas URI format:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.heam6ze.mongodb.net/student_academic_monitoring?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/student_academic_monitoring

# ------------------------------------------------------------------------------
# 2. JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=saepcs_super_secret_jwt_key_2026_academic_monitoring
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. Email Service Configuration (Nodemailer / SMTP)
# ------------------------------------------------------------------------------
# For real email delivery (e.g. Gmail App Password, SendGrid, Amazon SES, or Brevo):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_institution_email@gmail.com
# SMTP_PASS=your_16_character_app_password
# EMAIL_FROM=alerts@academic-monitoring.edu
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=demo_academic_notifier@ethereal.email
SMTP_PASS=demo_academic_password
EMAIL_FROM=alerts@academic-monitoring.edu
# Set to 'true' to force simulated outbox logging (no real emails sent):
EMAIL_SIMULATION=false

# ------------------------------------------------------------------------------
# 4. SMS Gateway Configuration (Twilio SMS / Fast2SMS)
# ------------------------------------------------------------------------------
# Provider Options: 'twilio', 'fast2sms', or 'mock' (simulation mode)
# In 'mock' mode, messages are logged to console and stored in DB with 'simulated' status.
SMS_PROVIDER=mock

# Twilio SMS Credentials:
TWILIO_ACCOUNT_SID=AC_mock_twilio_account_sid
TWILIO_AUTH_TOKEN=mock_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# Fast2SMS Alternative (India SMS Route):
FAST2SMS_API_KEY=mock_fast2sms_api_key

# ------------------------------------------------------------------------------
# 5. Automated Programmable Voice Calls (Twilio Voice - Outbound Phone Calling)
# ------------------------------------------------------------------------------
# Programmable Voice allows automated calls to read notifications aloud in English
# and regional Indian languages (e.g. Tamil) to parents who cannot read.
# Provider Options: 'twilio_voice' or 'browser_tts'
VOICE_PROVIDER=browser_tts

# Enable outbound voice phone calls (requires real TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN)
# Set to 'true' once real credentials are provided. When false, system operates in
# Development Simulation Mode with clear simulation receipts (does not claim real calls).
TWILIO_VOICE_CALL_ENABLED=false
TWILIO_VOICE_CALLER_ID=+15551234567

# Optional Twilio Voice Webhook URL (e.g. ngrok or deployed backend endpoint)
# TWILIO_VOICE_TWIML_URL=https://your-domain.com/api/notifications/voice/twiml

# ------------------------------------------------------------------------------
# 6. Client Application URL (CORS)
# ------------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173
